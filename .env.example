# Copy this file to a new file called .env (same folder as package.json) and fill it in.
# Every variable the app reads is listed here. The format is one NAME=value per line:
#   - no spaces around the =
#   - no quotes needed
#   - a line starting with # is a comment
# After you change .env, stop the server (Ctrl+C) and run npm run dev again. It is only read on start-up.
# Then run   npm run check:setup   to see what is working. Never commit .env or paste its contents in chat.

# ---------------------------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------------------------

# Port for the API server. In development the web app runs on 5173 and proxies /api to this port.
PORT=3000

# Where the SQLite database file lives. Created and seeded automatically on first start.
DATABASE_PATH=./data/altitude.db

# Where pictures uploaded from the dashboard and the events page are kept. On a host with a disk
# attached (for example Render), point this at the disk so they survive a redeploy.
UPLOAD_DIR=./data/uploads

# Set to production when deploying. Enables secure cookies and trusts one reverse proxy hop.
NODE_ENV=development

# ---------------------------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------------------------

# Demo mode shows a clearly labelled "Continue as demo student" button on the sign-in screen,
# so the app can be demoed without Google. true or false. Use false on a real deployment.
DEMO_MODE=true

# Google Sign-In for customers. Leave empty to hide the Google button.
#
# How to get it (about five minutes, free):
#   1. Go to https://console.cloud.google.com/ and create or pick a project.
#   2. APIs & Services > OAuth consent screen. Choose "External". Fill in the app name and your email.
#      While the app is in "Testing", only people you list under "Test users" can sign in. To let any
#      student in, press "Publish app" (the basic profile and email scopes need no Google review).
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
#   4. Under "Authorised JavaScript origins" add each address the app is opened from. Only the
#      address, no path and no trailing slash:
#        http://localhost:5173          when you run npm run dev
#        http://localhost:3000          when the built app is served by the server
#        https://your-deployed-site     once you deploy
#      Leave "Authorised redirect URIs" empty. This sign-in does not use one.
#   5. Copy the "Client ID" into the line below. It ends in .apps.googleusercontent.com.
#      You do NOT need the client secret. This app never uses it, so do not put it here.
#
# Google does not accept an IP address as an origin, so a phone opening the app at
# http://192.168.x.x:5173 cannot use Google sign-in. Use DEMO_MODE for that.
GOOGLE_CLIENT_ID=

# Optional. Only let these email domains sign in with Google. Comma separated, no @, exact match.
# Example: rit.edu,g.rit.edu    Leave empty to allow any Google account with a verified email.
ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------------------------
# "What are you in the mood for?" (Gemini)
# ---------------------------------------------------------------------------------------------

# The suggester always works without a key, using a built-in scorer that reads the menu's tags.
# With a Gemini key, Gemini reads what the customer wrote and writes the one-line reasons. Its answer is
# checked against the real menu (unknown or sold-out items are dropped), and if Gemini is slow, out of
# quota or wrong, the customer silently gets the built-in answer instead.
#
# How to get a key: https://aistudio.google.com/apikey  (Create API key). The free tier is enough for a demo.
# The key stays on the server. It is never sent to the browser. What a customer types is sent to Google.
GEMINI_API_KEY=

# Optional. Leave empty to use the default, gemini-3.8-flash. Other codes from Google's model list also
# work, for example gemini-3.6-flash or gemini-3.5-flash-lite (cheaper and faster).
GEMINI_MODEL=

# Optional alternative. Only used when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------------------------
# Dashboard accounts
# ---------------------------------------------------------------------------------------------

# Passwords for the seeded dashboard accounts (admin and barista). They are used only when the
# database is first created, so changing them later does nothing to an existing database.
# Change these for anything that is not a local demo.
SEED_ADMIN_PASSWORD=altitude-admin
SEED_BARISTA_PASSWORD=altitude-barista
