# Copy this file to .env and fill in what you need. Every variable the app reads is listed here.

# Port for the API server. In development the web app runs on 5173 and proxies /api to this port.
PORT=3000

# Where the SQLite database file lives. Created and seeded automatically on first start.
DATABASE_PATH=./data/altitude.db

# Demo mode shows a clearly labelled "Continue as demo student" button on the sign-in screen,
# so the app can be demoed without Google credentials. Set to false for a real deployment.
DEMO_MODE=true

# Google Sign-In (Google Identity Services) for customers.
# Create an OAuth 2.0 Web client in Google Cloud Console (APIs & Services > Credentials), then add
# these under "Authorised JavaScript origins":
#   http://localhost:5173        (development)
#   http://localhost:3000        (production build served by the API server)
#   https://your-deployed-domain (your public URL)
# Google does not accept plain IP addresses as origins, so a phone opening the app by LAN IP
# (http://192.168.x.x:5173) cannot use Google sign-in. Use DEMO_MODE for that.
GOOGLE_CLIENT_ID=

# Optional. Comma-separated email domains allowed to sign in with Google, for example "rit.edu".
# Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS=

# Passwords for the seeded dashboard accounts (admin and barista), used only when the
# database is first created. Change these for anything that is not a local demo.
SEED_ADMIN_PASSWORD=altitude-admin
SEED_BARISTA_PASSWORD=altitude-barista

# Set to production when deploying. Enables secure cookies and trusts one reverse proxy hop.
NODE_ENV=development
